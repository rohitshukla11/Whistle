# Contract addresses come from deployments/fixture-*.json at build time, so they
# are not configuration. These two are.
#
# Both are BROWSER variables — whatever you put here ships to every visitor.
# Never use the key the deploy signs with, and restrict these at the provider
# (Alchemy/Infura dashboard -> Allowlist -> HTTP referrers) to the deployment's
# origins. A key that has been pasted anywhere public is spent: rotate it.
#
# Why two: state reads and log scans want different things from an RPC, and no
# single free endpoint is good at both.
#
#   NEXT_PUBLIC_RPC_URL       state. The fixture screen issues ~200 multicalls.
#                             Alchemy and Infura handle it; publicnode, drpc and
#                             1rpc all fail or stall on it.
#   NEXT_PUBLIC_LOGS_RPC_URL  history (event feed, agent log, mint cost basis).
#                             Alchemy's FREE tier answers eth_getLogs over a TEN
#                             BLOCK range and 400s anything wider, which shows up
#                             as an empty feed rather than an error. publicnode
#                             serves 10,000 blocks and needs no key.
#
# If you have one endpoint that does both well (Infura does), point both at it.
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_RESTRICTED_KEY
NEXT_PUBLIC_LOGS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Local dev only: show the illustrative board on / when the chain is unreachable.
# Never set this in a production build — without it an unreadable board says so
# instead of showing invented prices.
NEXT_PUBLIC_ILLUSTRATIVE=

# Build-time only, never shipped to the browser: freezes settled fixtures' logs
# into public/settled/ so /settlement paints in ~2.6s instead of scanning live.
# Falls back to NEXT_PUBLIC_LOGS_RPC_URL. If it is unreachable the build still
# succeeds and those screens scan at runtime — slower, same answer.
SNAPSHOT_RPC_URL=

# Optional: the AI match debrief on /profile/[agent]. `on` shows it; anything
# else and the panel is not even fetched.
NEXT_PUBLIC_DEBRIEF=

# SECRET, and server-only on purpose — no NEXT_PUBLIC_ prefix, so it never
# reaches the browser. Read by app/api/debrief/route.ts. Without it the panel
# says so rather than sitting blank. DEBRIEF_MODEL overrides the model,
# ANTHROPIC_BASE_URL the endpoint.
ANTHROPIC_API_KEY=

# ---------------------------------------------------- browser-driven match sim
# `on` adds the MATCH SIMULATION panel to /fixture and enables /api/sim/*.
# Operator feature, not a visitor one: off by default, and every button is a
# request to a server route that holds the keys. The browser signs one message —
# "Whistle sim · <fixtureId> · <unix minute>" — and the routes accept it for 6
# hours if the signer is AgentRegistry.operator(). There is no admin token.
NEXT_PUBLIC_SIM=

# SECRET, server-only — no NEXT_PUBLIC_ prefix, on purpose.
#   SIM_SERVICE_KEY  one key for oracle + keeper (overrides the two below).
#   SIM_DERIVED_FILE path to .secrets/derived.json: per-fixture agents and the
#                    managed pool /api/agents/assign hands out. Local server.
#   SIM_DERIVED_JSON the same document inline, as JSON or base64 of it — for a
#                    host with no files (Vercel). Wins over SIM_DERIVED_FILE.
#                      base64 < .secrets/derived.json | pbcopy
#   SIM_OPERATOR_KEY the operator (AgentRegistry.operator()); World ID's
#                    protected actions are signed with it, on the server.
#   SIM_ORACLE_KEY   posts kickoff and every match event. Needs ROLE_POST_EVENT.
#   SIM_KEEPER_KEY   runs the paginated tick() that fills the queue.
#   SIM_AGENT_KEYS   comma-separated, six. Each must already be registered via
#                    AgentRegistry.createAgent FOR THIS FIXTURE — an agent minted
#                    against another one is skipped before it costs any reads.
SIM_SERVICE_KEY=
SIM_DERIVED_FILE=
SIM_DERIVED_JSON=
SIM_OPERATOR_KEY=
SIM_ORACLE_KEY=
SIM_KEEPER_KEY=
SIM_AGENT_KEYS=

# Optional: where the sim signs. Falls back to SNAPSHOT_RPC_URL then
# NEXT_PUBLIC_RPC_URL. Point it at http://127.0.0.1:8545 for a fork rehearsal.
SIM_RPC_URL=

# Fixtures /api/sim/start refuses to kick off without confirm=1, comma-separated.
PROTECTED_FIXTURES=

# ------------------------------------------------------------------- World ID
# `on`: creating an agent, raising its cap and resuming it need a fresh World ID
# proof; the server performs them after the callback. Pause, lower cap and
# revoke never do. Needs every variable below and SIM_OPERATOR_KEY.
NEXT_PUBLIC_WORLD_IDP=
# The app's public origin, e.g. https://whistle.example.vercel.app
NEXT_PUBLIC_APP_URL=
WORLD_ISSUER=https://sandbox.auth.world.org
# A client registered for THIS hostname: the sector is the redirect hostname and
# cannot change, so the localhost client does not work on a deployed domain.
WORLD_CLIENT_ID=
# Exactly as registered: <NEXT_PUBLIC_APP_URL>/api/world/callback
WORLD_REDIRECT_URI=
# SECRET, server-only. The RS256 private_key_jwt key: the PEM itself (Vercel;
# "\n" escapes are fine), or a path to it (local server).
WORLD_PRIVATE_KEY=
WORLD_PRIVATE_KEY_FILE=

# Shared store (Vercel KV / Upstash Redis REST). REQUIRED for World ID on
# Vercel: the start, the callback and each status poll can land on different
# instances, so a pending verification must live outside the process. Without
# it the start route refuses on Vercel rather than lose attempts at random.
# Locally, an in-process store is used when these are empty.
KV_REST_API_URL=
KV_REST_API_TOKEN=
