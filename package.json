{
  "name": "whistle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live fantasy-football player cards priced off a match clock. ENSv2 mandates, Uniswap v4 execution.",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "replay": "tsx oracle/replay.ts",
    "agents": "tsx agent/runtime.ts",
    "demo-wallets": "tsx scripts/demo-wallets.ts",
    "deploy:sepolia": "tsx scripts/deploy-sepolia.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "test": "cd contracts && forge test",
    "test:all": "pnpm test && pnpm test:ts && pnpm typecheck",
    "test:ts": "tsx test/resend.test.ts && tsx --test web/lib/world/flow.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
