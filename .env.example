# ---------------------------------------------------------------- networking
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<infura-project-id>

# Which chain the deployed addresses belong to: sepolia | anvil.
# NOTE: a local anvil FORK of Sepolia reports chain id 11155111, not 31337 — so a
# fork run wants WHISTLE_CHAIN=sepolia with WHISTLE_RPC_URL pointed at localhost.
WHISTLE_CHAIN=sepolia
# WHISTLE_RPC_URL=http://127.0.0.1:8545
# WHISTLE_DEPLOYMENT=deployments/11155111.json

# ------------------------------------------------------------------- secrets
# Must carry the 0x prefix: forge script reads keys with vm.envUint, which rejects
# a bare hex string. `cast` accepts either, so a missing prefix only shows up when
# a script first broadcasts.
DEPLOYER_PRIVATE_KEY=0x<64 hex chars>

# Posts kickoff, events and postFinal. Needs ROLE_POST_EVENT.
ORACLE_PRIVATE_KEY=0x<64 hex chars>
# Optional; falls back to the oracle key.
KEEPER_PRIVATE_KEY=0x<64 hex chars>

# Comma-separated. Each must already be registered via AgentRegistry.createAgent.
AGENT_PRIVATE_KEYS=0x<key>,0x<key>,0x<key>,0x<key>,0x<key>,0x<key>
# Comma-separated. The eight demo humans.
DEMO_WALLET_KEYS=0x<key>,0x<key>,0x<key>,0x<key>,0x<key>,0x<key>,0x<key>,0x<key>

ETHERSCAN_API_KEY=

# ----------------------------------------------------------------------- ENS
# Owner of the live `whistle.eth` on the ENSv2 Sepolia beta, registered
# 2026-09-22 in block 11,753,322. Set: the ENS fork tests bind to the real name
# and fork at LIVE_NAME_FORK_BLOCK. Unset: they self-register the name inside the
# fork at the older FORK_BLOCK. Both paths must pass.
WHISTLE_ROOT_OWNER=0x68343Aa0598b7FCAA102769D172e59cdDfae10f2
# Who owns the six mandates. Defaults to the DEPLOYER/OPERATOR address, because
# `AgentRegistry.createAgent` is `onlyOperator` — the /agents form only works
# from the operator's wallet, so for the demo the two are one key. Production
# separates them; see docs/saturday.md.
DEMO_USER_ADDRESS=

# ------------------------------------------------ live feed (optional, step 6)
# oracle/live-adapter.ts. Compiles and is wired, but is not exercised by tests.
# FOOTBALL_API_KEY=
# FOOTBALL_API_HOST=v3.football.api-sports.io
# FOOTBALL_FIXTURE_ID=
# FOOTBALL_POLL_SECONDS=15
# FOOTBALL_HEARTBEAT_MINUTES=5

# Comma-separated fixture ids that no script may write to on a real network.
# Put the demo fixture here the moment it is deployed: `pnpm replay` settles the
# fixture it runs on, and there is no way to reopen one. A local RPC (an anvil
# fork) is exempt, so rehearsals still run the real commands against real state.
PROTECTED_FIXTURES=

# A SECOND provider key, used only by `anvil --fork-url`. Never by the frontend,
# the keeper, the agents or the scripts — those all use SEPOLIA_RPC_URL.
#
# A fork fetches every storage slot it touches from upstream, so a rehearsal is
# by far the heaviest consumer in the stack. Give it its own key or it will rate
# limit everything else, anvil included.
FORK_RPC_URL=
