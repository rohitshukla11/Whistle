# Everything is ignored, then what belongs in the repo is let back in — so a
# stray key, build artefact or vendored dependency cannot be added by accident.
*
!*/
!/.gitignore

# ----------------------------------------------------------------- contracts
!contracts/src/**/*.sol
!contracts/script/**/*.sol
!contracts/test/**/*.sol

contracts/lib/
contracts/out/
contracts/cache/
contracts/broadcast/

# ------------------------------------------------------------------ frontend
!web/**

# What web/scripts/vendor.mjs reads from the repo root at build time. A host that
# builds from the git checkout (Vercel) has nothing else, so each of these is a
# failed build if it is left out. Only these files — the rest of oracle/ and
# agent/ is the terminal runtime and stays out.
!deployments/*.json
!fixtures/che-bar-2009-05-06.json
!oracle/abi.ts
!oracle/tx.ts
!oracle/types.ts
!oracle/scoring.ts
!oracle/agent-prep.ts
!agent/evaluate.ts
!agent/templates/*.ts

# Generated, vendored or enormous. `vendor/` is written by scripts/vendor.mjs at
# build time and `public/settled/` by the snapshot step: committing either would
# be committing the same answer twice, and one of them would go stale.
web/node_modules/
web/.next/
web/vendor/
web/public/settled/
web/.vercel/
web/tsconfig.tsbuildinfo
web/next-env.d.ts

# Screenshots are regenerated by `node scripts/shots.mjs`; 8.5 MB of PNGs that
# change every run does not belong in history.
web/docs/screens/

# ----------------------------------------------- never, under any circumstances
.env
.env.*
.secrets/
**/*.key
**/*.pem

# The example carries no secrets and is the only way to know what to set.
!web/.env.example
!/.env.example
